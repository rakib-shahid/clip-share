# Generate each value independently, for example:
# openssl rand -base64 48
CLIP_SHARE_SESSION_SECRET=replace-with-at-least-32-random-bytes
CLIP_SHARE_SETUP_TOKEN=replace-with-at-least-32-random-characters

# Production/Komodo values:
CLIP_SHARE_BASE_URL=https://clips.example.com
CLIP_SHARE_DATA_PATH=/absolute/host/path/clip-share
CLIP_SHARE_PORT=43138
CLIP_SHARE_IMAGE=your-dockerhub-username/clip-share:latest
